    {
      "id": "c3main",
      "settings": {
        "classes": { "$$type": "classes", "value": ["e-c3main-style"] }
      },
      "elements": [
        {
          "id": "c3searchrow",
          "settings": {
            "html": "<div class=\"trails-search-row\" style=\"display: flex; gap: 10px; margin-bottom: 16px; max-width: 1000px; margin-left: auto; margin-right: auto; padding: 0 20px; box-sizing: border-box;\">\n  <input id=\"search-box\" type=\"text\" placeholder=\"Search trails...\" style=\"padding: 10px; font-size: 15px; flex: 1; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;\" />\n  <select id=\"category\" style=\"padding: 10px; font-size: 15px; flex: 1; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;\">\n    <option value=\"all\">All categories</option>\n    <option value=\"mountain\">Mountain</option>\n    <option value=\"beach\">Beach</option>\n    <option value=\"forest\">Forest</option>\n  </select>\n</div>\n<p id=\"trails-no-results\" hidden style=\"color: #a00; margin: 12px 20px; max-width: 1000px; margin-left: auto; margin-right: auto;\">No trails found.</p>"
          },
          "elements": [],
          "isInner": false,
          "widgetType": "html",
          "elType": "widget"
        },
        {
          "id": "c3cards",
          "settings": {
            "html": "<div class=\"trails-cards\" style=\"display: flex; flex-wrap: wrap; gap: 14px; max-width: 1000px; margin: 0 auto; padding: 0 20px; box-sizing: border-box; width: 100%;\">\n  <article class=\"trail-card\" data-category=\"mountain\" style=\"border: 1px solid #ddd; border-radius: 8px; padding: 14px; min-width: 0; background: #fff; flex: 1 1 280px; box-sizing: border-box;\">\n    <h3 style=\"font-size: 17px; margin: 0 0 6px 0;\">Mount Rinjani Sunrise</h3>\n    <p style=\"margin: 0 0 8px 0;\">2-day guided summit trek, Lombok.</p>\n    <span class=\"price\" style=\"font-weight: bold; color: #0c6b4f;\">RM 350 / pax</span>\n  </article>\n  <article class=\"trail-card\" data-category=\"beach\" style=\"border: 1px solid #ddd; border-radius: 8px; padding: 14px; min-width: 0; background: #fff; flex: 1 1 280px; box-sizing: border-box;\">\n    <h3 style=\"font-size: 17px; margin: 0 0 6px 0;\">Pulau Perhentian Coastal Walk</h3>\n    <p style=\"margin: 0 0 8px 0;\">Easy coastal trail, Terengganu.</p>\n    <span class=\"price\" style=\"font-weight: bold; color: #0c6b4f;\">RM 120 / pax</span>\n  </article>\n  <article class=\"trail-card\" data-category=\"forest\" style=\"border: 1px solid #ddd; border-radius: 8px; padding: 14px; min-width: 0; background: #fff; flex: 1 1 280px; box-sizing: border-box;\">\n    <h3 style=\"font-size: 17px; margin: 0 0 6px 0;\">Taman Negara Canopy Trail</h3>\n    <p style=\"margin: 0 0 8px 0;\">Rainforest walk, Pahang.</p>\n    <span class=\"price\" style=\"font-weight: bold; color: #0c6b4f;\">RM 180 / pax</span>\n  </article>\n  <article class=\"trail-card\" data-category=\"mountain\" style=\"border: 1px solid #ddd; border-radius: 8px; padding: 14px; min-width: 0; background: #fff; flex: 1 1 280px; box-sizing: border-box;\">\n    <h3 style=\"font-size: 17px; margin: 0 0 6px 0;\">Mount Kinabalu Base Trek</h3>\n    <p style=\"margin: 0 0 8px 0;\">Highland trek, Sabah.</p>\n    <span class=\"price\" style=\"font-weight: bold; color: #0c6b4f;\">RM 420 / pax</span>\n  </article>\n  <article class=\"trail-card\" data-category=\"beach\" style=\"border: 1px solid #ddd; border-radius: 8px; padding: 14px; min-width: 0; background: #fff; flex: 1 1 280px; box-sizing: border-box;\">\n    <h3 style=\"font-size: 17px; margin: 0 0 6px 0;\">Langkawi Sunset Ridge</h3>\n    <p style=\"margin: 0 0 8px 0;\">Evening ridge walk, Kedah.</p>\n    <span class=\"price\" style=\"font-weight: bold; color: #0c6b4f;\">RM 95 / pax</span>\n  </article>\n  <article class=\"trail-card\" data-category=\"forest\" style=\"border: 1px solid #ddd; border-radius: 8px; padding: 14px; min-width: 0; background: #fff; flex: 1 1 280px; box-sizing: border-box;\">\n    <h3 style=\"font-size: 17px; margin: 0 0 6px 0;\">Belum Mossy Forest</h3>\n    <p style=\"margin: 0 0 8px 0;\">Misty forest trail, Perak.</p>\n    <span class=\"price\" style=\"font-weight: bold; color: #0c6b4f;\">RM 150 / pax</span>\n  </article>\n</div>"
          },
          "elements": [],
          "isInner": false,
          "widgetType": "html",
          "elType": "widget"
        },
        {
          "id": "c3booking",
          "settings": {
            "html": "<section class=\"trails-booking\" style=\"margin-top: 28px; border-top: 2px solid #eee; padding-top: 18px; max-width: 1000px; margin-left: auto; margin-right: auto; padding-left: 20px; padding-right: 20px;\">\n  <h2 style=\"font-size: 24px; margin: 0 0 14px 0;\">Book a guided hike</h2>\n  <form id=\"booking-form\" style=\"display: flex; flex-direction: column; gap: 12px; max-width: 420px;\">\n    <input type=\"hidden\" name=\"trails_booking\" value=\"1\">\n    <label style=\"display: flex; flex-direction: column; gap: 4px;\">Name\n      <input type=\"text\" name=\"name\" required style=\"padding: 9px; font-size: 15px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; width: 100%;\" />\n    </label>\n    <label style=\"display: flex; flex-direction: column; gap: 4px;\">Date\n      <input type=\"date\" name=\"date\" required style=\"padding: 9px; font-size: 15px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; width: 100%;\" />\n    </label>\n    <div style=\"display: flex; align-items: center; gap: 12px; flex-wrap: wrap;\">\n      <span style=\"font-weight: 600; min-width: 110px;\">Digital Nomad:</span>\n      <label><input type=\"radio\" name=\"digital_nomad\" value=\"Ya\" required /> Ya</label>\n      <label><input type=\"radio\" name=\"digital_nomad\" value=\"Tidak\" required /> Tidak</label>\n    </div>\n    <div style=\"display: flex; align-items: center; gap: 12px; flex-wrap: wrap;\">\n      <span style=\"font-weight: 600; min-width: 110px;\">Package Plan:</span>\n      <label><input type=\"radio\" name=\"pricing_plan\" value=\"Daily\" required /> Daily</label>\n      <label><input type=\"radio\" name=\"pricing_plan\" value=\"Monthly\" required /> Monthly</label>\n    </div>\n    <label style=\"display: flex; align-items: center; gap: 8px; cursor: pointer;\">\n      <input type=\"checkbox\" name=\"host_terms\" value=\"1\" required /> I agree to the Host Terms\n    </label>\n    <p id=\"trails-total\" style=\"font-weight: bold; font-size: 16px; margin: 4px 0;\">Total: -</p>\n    <button type=\"submit\" style=\"padding: 11px; background: #0c6b4f; color: #fff; border: 0; cursor: pointer; border-radius: 4px; font-size: 16px;\">Request booking</button>\n  </form>\n  <div id=\"trails-confirmation\" hidden style=\"margin-top: 12px; border: 1px solid #0c6b4f; border-radius: 8px; padding: 12px; background: #eef7f2;\"></div>\n</section>"
          },
          "elements": [],
          "isInner": false,
          "widgetType": "html",
          "elType": "widget"
        }
